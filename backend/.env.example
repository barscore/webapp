# Server
PORT=3000
NODE_ENV=development

# Supabase — auth handled by Supabase Auth (email/password + Google OAuth).
# Backend verifies the user's access token via auth.getUser (service-role key)
# and uses the service-role key for writes.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here

# CORS — allowlist of frontend origins (comma-separated). Add the LAN IP / prod
# domain the app is actually served from, otherwise iOS Safari / the PWA get
# blocked ("impossibile caricare i bar"). "*" allows any origin: dev-only,
# never in production — it lets any website drive the API from the browser.
# Example: http://localhost:5173,http://192.168.1.50:5173,https://rabar.app
FRONTEND_URL=http://localhost:5173

# Rate limiting (per IP, fixed window). GLOBAL_MAX guards every route; the
# public POST /suggestions has its own stricter 5/min limit in code.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_GLOBAL_MAX=120

# OpenStreetMap data sources (free, no key). Defaults shown; override only if
# you self-host Overpass/Nominatim. Set a real contact in the User-Agent.
OVERPASS_URL=https://overpass-api.de/api/interpreter
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSM_USER_AGENT=rabar/1.0 (contact: your-email@example.com)
