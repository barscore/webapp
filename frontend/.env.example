# API Backend — must be reachable from the DEVICE running the app. On a phone,
# "localhost" is the phone itself: use the dev machine's LAN IP (or a public
# HTTPS URL). iOS PWA + geolocation need HTTPS, so mixed content (HTTPS page →
# HTTP api) is blocked. Baked at build time — rebuild after changing.
# In produzione si imposta nelle Environment Variables del progetto Vercel:
# Vite le legge al BUILD, quindi cambiarla richiede un redeploy.
# Example: http://192.168.1.50:3000  or  https://rabarbackend.vercel.app
VITE_API_BASE_URL=http://localhost:3000

# Supabase (auth: email/password + Google OAuth). Use the ANON key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Bar data comes free from OpenStreetMap (map tiles, Overpass, Nominatim) via the
# backend — no map/places API key needed.

# Google AdSense — publisher id. Vuoto = nessuna pubblicita' (ne' Auto Ads ne'
# unita' fisse), utile in locale.
VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
# Id delle unita' display fisse (AdSense → Annunci → Per unita' pubblicitaria).
# Ogni id vuoto = quello slot non viene renderizzato affatto.
# La layout key la dà AdSense insieme all'unità In-feed.
VITE_ADSENSE_LAYOUT_KEY_LIST=
VITE_ADSENSE_SLOT_LIST=
VITE_ADSENSE_SLOT_BAR=
VITE_ADSENSE_SLOT_BOARD=

# Web Push — chiave VAPID pubblica (la stessa coppia del backend).
# Genera con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# App config
VITE_APP_NAME=rabar
VITE_DEFAULT_LAT=45.4654
VITE_DEFAULT_LNG=9.1859
VITE_DEFAULT_ZOOM=14
