# API Backend — must be reachable from the DEVICE running the app. On a phone,
# "localhost" is the phone itself: use the dev machine's LAN IP (or a public
# HTTPS URL). iOS PWA + geolocation need HTTPS, so mixed content (HTTPS page →
# HTTP api) is blocked. Baked at build time — rebuild after changing.
# Example: http://192.168.1.50:3000  or  https://api.rabar.app
VITE_API_BASE_URL=http://localhost:3000

# Supabase (auth: email/password + Google OAuth). Use the ANON key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Bar data comes free from OpenStreetMap (map tiles, Overpass, Nominatim) via the
# backend — no map/places API key needed.

# Google AdSense
VITE_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# Web Push — chiave VAPID pubblica (la stessa coppia del backend).
# Genera con: npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# App config
VITE_APP_NAME=rabar
VITE_DEFAULT_LAT=45.4654
VITE_DEFAULT_LNG=9.1859
VITE_DEFAULT_ZOOM=14
